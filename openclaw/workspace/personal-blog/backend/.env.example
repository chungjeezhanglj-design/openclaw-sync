# 后端环境配置
NODE_ENV=development
PORT=3000

# 前端域名配置
FRONTEND_URL=http://localhost:5173

# 数据库配置 (MariaDB/MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=personal_blog

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# 微信配置（可选）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3000/api/auth/wechat/callback

# AI服务配置
AI_PROVIDER=mock
# AI_PROVIDER=tongyi
# TONGYI_API_KEY=
# TONGYI_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# AI_PROVIDER=minimax
# MINIMAX_API_KEY=

# 文件上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
