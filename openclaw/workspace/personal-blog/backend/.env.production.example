# =============================================================================
# 个人博客系统 · 生产环境 .env 模板
# =============================================================================
# 使用方法:
#   1. cp backend/.env.production.example backend/.env.production
#   2. ./scripts/generate-secrets.sh backend/.env.production   # 生成密钥
#   3. 手动编辑剩余字段 (DB 密码 / AI API Key 等)
#   4. docker-compose --env-file backend/.env.production up -d
#
# ⚠️  注意:
#   - 此文件不进 git (.gitignore 已屏蔽 .env*)
#   - .env.production 是真实密钥载体, 请妥善保管 (建议 1Password / Bitwarden)
#   - 默认 admin 密码必须改 — 见末尾 ADMIN_PASSWORD
# =============================================================================

# ===== 运行环境 =====
NODE_ENV=production
PORT=3000
HOST=::

# ===== 数据库 (MariaDB) =====
DB_HOST=mariadb
DB_PORT=3306
DB_USERNAME=personal_blog
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_DATABASE=personal_blog

# ===== 管理员账户 =====
# ⚠️  必改! 部署后通过 /setup 页面创建第一个管理员, 然后立即删掉这两行
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_AT_LEUP_12_CHARS_LONG

# ===== JWT 密钥 (运行 generate-secrets.sh 自动填充) =====
# 格式: 64 字符十六进制 = 256 bit 熵
JWT_SECRET=GENERATE_WITH_scripts/generate-secrets.sh
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_WITH_scripts/generate-secrets.sh
JWT_REFRESH_EXPIRES_IN=30d

# ===== 微信登录 (可选) =====
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=https://chungjee.familyds.org/api/auth/wechat/callback

# ===== AI 服务 =====
# 推荐: tongyi / moonshot / minimax (云端, 可用性高)
# 备选: ollama (本地, 需要华矿机 192.168.1.111 在线)
AI_PROVIDER=tongyi
AI_FALLBACK_PROVIDER=ollama

# Tongyi (通义千问) — 阿里云 DashScope
TONGYI_API_KEY=YOUR_TONGYI_API_KEY
TONGYI_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Moonshot (Kimi) — 月之暗面
MOONSHOT_API_KEY=YOUR_MOONSHOT_API_KEY
MOONSHOT_ENDPOINT=https://api.moonshot.cn/v1/chat/completions

# MiniMax (海螺 AI) — MiniMax
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY

# Ollama (本地) — 192.168.1.111:11434 (华矿机)
# 注意: 如果 AI_PROVIDER=ollama 但华矿机离线, fallback 到云端
OLLAMA_BASE_URL=http://192.168.1.111:11434
OLLAMA_MODEL=openbmb/minicpm-v4.5:8b

# ===== 文件上传 =====
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=20971520            # 20MB (nginx client_max_body_size 同步设置)

# ===== 后端地址 (供前端 CORS / AI 反向代理使用) =====
BACKEND_URL=https://chungjee.familyds.org

# ===== 高德地图逆地理编码 (可选) =====
# 申请: https://lbs.amap.com/
AMAP_KEY=YOUR_AMAP_KEY

# ===== 速率限制 (防滥用) =====
# 默认: 1000 req / 15min / IP (登录/注册接口在代码内有更严限制)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ===== 日志级别 =====
LOG_LEVEL=info
# debug | info | warn | error